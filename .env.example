# Apify API token — https://console.apify.com/settings/integrations
# Required. Never committed, never logged, never included in tool output.
APIFY_TOKEN=

# Comma-separated actor allowlist. Only these actors can be started.
# Defaults to a curated set of public scraping actors when unset.
# WEB_DATA_MCP_ALLOWED_ACTORS=apify/website-content-crawler,apify/cheerio-scraper

# Bearer token required by the Streamable HTTP transport (--transport http).
# Unused in stdio mode.
# WEB_DATA_MCP_HTTP_TOKEN=

# OTLP/HTTP collector. Setting it turns on one span per tool call; unset, the
# OpenTelemetry SDK is never even imported. Must be an http(s) URL — there is
# deliberately no console exporter, because stdout carries the MCP protocol.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Standard per-signal override. When set it wins over the base endpoint above,
# and it is held to the same http(s) rule — a grpc:// value turns tracing OFF
# with a message rather than exporting into nothing.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
