{
  "name": "web-data-mcp",
  "version": "0.1.0",
  "description": "MCP server that turns Apify web-scraping actors into quality-gated, RAG-ready data tools for AI agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apify",
    "web-scraping",
    "rag",
    "ai-agents",
    "data-quality"
  ],
  "mcpName": "io.github.fctpe/web-data-mcp",
  "license": "MIT",
  "author": "Furkan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fctpe/web-data-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "hono": "^4.13.10",
      "@hono/node-server": "^2.0.5"
    }
  },
  "bin": {
    "web-data-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "biome check src test scripts",
    "lint:fix": "biome check --write src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "ajv": "^8.17.1",
    "apify-client": "^2.25.0",
    "hono": "^4.13.10",
    "js-tiktoken": "^1.0.21",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": { "optional": true },
    "@opentelemetry/exporter-trace-otlp-http": { "optional": true },
    "@opentelemetry/sdk-trace-base": { "optional": true }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "2.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
